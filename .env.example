# ---------------------------------------------------------------------------
# SoleIndex environment
# Copy to `.env.local` and fill in what you need. Everything has a working
# default, so the app runs with NO env file at all (see docs/architecture.md).
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# `pglite`  : embedded PostgreSQL (WASM) persisted to ./.data  <-- default, zero setup
# `postgres`: a real PostgreSQL server / Neon / Supabase connection string
SOLEINDEX_DB_DRIVER=pglite

# Used only when SOLEINDEX_DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Market data provider --------------------------------------------------
# `fixture` : reads the committed snapshot in ./fixtures  <-- default, offline-safe
# `kicksdb` : live calls to https://api.kicks.dev (free tier: 1,000 req/month)
SOLEINDEX_PROVIDER=fixture

# Used only when SOLEINDEX_PROVIDER=kicksdb
# KICKSDB_API_KEY=

# --- Demo auth -------------------------------------------------------------
# Secret used to sign the demo session cookie. Change it for any real deployment.
SOLEINDEX_SESSION_SECRET=dev-only-insecure-secret-change-me
